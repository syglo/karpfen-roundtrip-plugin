[comment encoding = UTF-8 /]
[module generateKMeta('http://www.eclipse.org/emf/2002/Ecore')/]

[import org::karpfen::serializer::AcceleoServices/]

[comment @main /]
[template public generateKMeta(pkg : ecore::EPackage)]
  [file ('output.kmeta', overwrite, 'UTF-8')]
    [for (c : ecore::EClass | pkg.getOrderedClasses()) separator('\n\n')]
      type "[c.name/]" "[c.getDocumentation()/]" {
      [for (a : ecore::EAttribute | c.getAttributes())]
        [if (a.isMany())]
            prop("[a.name/]", list("[a.eType.mapDataType()/]"))
        [else]
            prop("[a.name/]", "[a.eType.mapDataType()/]")
        [/if]
      [/for]
      [for (r : ecore::EReference | c.getContainmentReferences())]
        [if (r.isMany())]
            has("[r.name/]", list("[r.eType.name/]"))
        [else]
            has("[r.name/]", "[r.eType.name/]")
        [/if]
      [/for]
      [for (r : ecore::EReference | c.getAssociationReferences())]
        [if (r.isMany())]
            knows("[r.name/]", list("[r.eType.name/]"))
        [else]
            knows("[r.name/]", "[r.eType.name/]")
        [/if]
      [/for]
      }
    [/for]
  [/file]
[/template]