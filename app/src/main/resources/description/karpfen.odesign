                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="knows1Nlinklist" label="knows (1:N link list)" edgeMappings="//@ownedViewpoints[name='KarpfenViewpoint']/@ownedRepresentations[name='KMetaClassDiagram']/@additionalLayers[name='StraightRoutingLayer']/@edgeMappings[name='KnowsAssociationEdge'] //@ownedViewpoints[name='KarpfenViewpoint']/@ownedRepresentations[name='KMetaClassDiagram']/@additionalLayers[name='OrthogonalRoutingLayer']/@edgeMappings[name='OrthoKnowsAssociationEdge']">
