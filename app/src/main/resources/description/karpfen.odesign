        </toolSections>
        <toolSections name="RelationsSection" label="Relationships">
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="has11embedded" label="has (1:1 embedded)" edgeMappings="//@ownedViewpoints[name='KarpfenViewpoint']/@ownedRepresentations[name='KMetaClassDiagram']/@additionalLayers[name='StraightRoutingLayer']/@edgeMappings[name='HasCompositionEdge'] //@ownedViewpoints[name='KarpfenViewpoint']/@ownedRepresentations[name='KMetaClassDiagram']/@additionalLayers[name='OrthogonalRoutingLayer']/@edgeMappings[name='OrthoHasCompositionEdge']">
