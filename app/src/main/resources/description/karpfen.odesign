          </ownedTools>
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="knows11link" label="knows (1:1 link)" edgeMappings="//@ownedViewpoints[name='KarpfenViewpoint']/@ownedRepresentations[name='KMetaClassDiagram']/@additionalLayers[name='StraightRoutingLayer']/@edgeMappings[name='KnowsAssociationEdge'] //@ownedViewpoints[name='KarpfenViewpoint']/@ownedRepresentations[name='KMetaClassDiagram']/@additionalLayers[name='OrthogonalRoutingLayer']/@edgeMappings[name='OrthoKnowsAssociationEdge']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:source">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="ecore.EReference" referenceName="eStructuralFeatures" variableName="newRef">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'knows_' + target.name.toLowerFirst()"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="eType" valueExpression="aql:target"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="containment" valueExpression="aql:false"/>
