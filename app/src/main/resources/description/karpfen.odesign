          <ownedTools xsi:type="tool:DirectEditLabel" name="EditInstanceKnowsEdge">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.editInstanceEdge(view, arg0, false)"/>
            </initialOperation>
